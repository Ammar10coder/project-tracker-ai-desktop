# ============================================================
# Project Tracker AI — Desktop Control Panel
# Copy this file to ".env" in the same folder and fill in real
# values. ".env" is git-ignored and is never sent anywhere by
# the app itself — it is only read locally at startup.
# ============================================================

# --- Where the bot lives ------------------------------------
# "local"  = docker-compose runs on THIS Windows machine
# "remote" = bot runs on a remote server (e.g. Oracle Cloud VM)
#            and is controlled over SSH
PTA_MODE=local

# --- Local mode -----------------------------------------------
# Absolute Windows path to the project_tracker_ai repo/folder
# that contains docker-compose.yml (only needed if PTA_MODE=local)
PTA_LOCAL_PROJECT_DIR=C:\Users\YOURNAME\project_tracker_ai

# --- Remote mode (SSH) -----------------------------------------
PTA_REMOTE_HOST=xxx.xxx.xxx.xxx
PTA_REMOTE_USER=ubuntu
PTA_REMOTE_SSH_KEY_PATH=C:\Users\YOURNAME\.ssh\oracle_cloud_key.pem
PTA_REMOTE_PROJECT_DIR=/home/ubuntu/project_tracker_ai

# --- Docker container / compose service name --------------------
PTA_CONTAINER_NAME=project_tracker_ai

# --- Read-only path to the SQLite DB used for dashboard stats ----
# (a local copy, or synced/mounted path — the app never writes to it)
PTA_DB_PATH=C:\Users\YOURNAME\project_tracker_ai\data\project.db

# --- Optional: only needed if you enable the AI summary feature --
GEMINI_API_KEY=your_gemini_api_key_here
