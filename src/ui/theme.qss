/* ============================================================
   Palette / type ported 1:1 from the reference web dashboard's
   CSS custom properties (style.css):
     --bg #F3F7F0   --panel #FFFFFF   --border rgba(15,32,24,.12)
     --ink #0F2018  --muted #5C6F63
     --steel #1B2A66  --live #2CA85E  --stopped #B8842A  --danger #B23B2E
   Fonts: the reference uses Space Grotesk / Inter / IBM Plex Mono
   (Google Fonts, loaded over the network). A desktop app can't
   pull web fonts at runtime, so this uses the closest bundled
   Windows system fonts: Segoe UI Semibold (display), Segoe UI (UI),
   Consolas (mono). Swap these for embedded .ttf files later if you
   want an exact type match.
   ============================================================ */

QWidget {
    background-color: #F3F7F0;
    color: #0F2018;
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
}

/* ---- Tab bar restyled as a segmented nav, like the titlebar area ---- */
QTabWidget::pane {
    border: 1px solid rgba(15, 32, 24, 0.12);
    border-radius: 14px;
    background: transparent;
    top: 6px;
}

QTabBar::tab {
    background: #FFFFFF;
    color: #5C6F63;
    padding: 8px 20px;
    margin-right: 6px;
    border: 1px solid rgba(15, 32, 24, 0.12);
    border-radius: 10px;
    font-weight: 600;
    font-size: 12.5px;
}

QTabBar::tab:selected {
    background: #1B2A66;
    color: #FFFFFF;
    border-color: #1B2A66;
}

QTabBar::tab:hover:!selected {
    background: rgba(27, 42, 102, 0.06);
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #1B2A66;
    color: white;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 9px 18px;
    font-weight: 600;
    font-size: 13px;
}
QPushButton:hover { background-color: #24357f; }
QPushButton:disabled { background-color: #c9cfd8; color: #8890a0; }

/* Secondary / destructive action, e.g. Stop — outlined red on white,
   matching .btn-stop in the reference design */
QPushButton#dangerButton {
    background-color: #FFFFFF;
    color: #B23B2E;
    border: 1px solid rgba(178, 59, 46, 0.35);
}
QPushButton#dangerButton:hover { background-color: #FBEAE8; }
QPushButton#dangerButton:disabled { background-color: #f2f2f2; color: #c7a6a1; border-color: #eee; }

/* Ghost / tertiary action, e.g. Refresh — matching .btn-ghost */
QPushButton#ghostButton {
    background-color: transparent;
    color: #5C6F63;
    border: 1px solid rgba(15, 32, 24, 0.12);
}
QPushButton#ghostButton:hover { background-color: rgba(27, 42, 102, 0.06); color: #1B2A66; }

/* ---- Inputs ---- */
QLineEdit, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 32, 24, 0.12);
    border-radius: 8px;
    padding: 7px;
    selection-background-color: #1B2A66;
}

/* ---- Log panel body — matches .log-body: mono, soft off-white ---- */
QPlainTextEdit#logBody {
    font-family: Consolas, "IBM Plex Mono", monospace;
    font-size: 12px;
    background-color: #FBFCF9;
    color: #2B3A32;
    border: 1px solid rgba(15, 32, 24, 0.12);
    border-radius: 14px;
    padding: 16px 18px;
}

/* ---- Table (task summary) styled like a card ---- */
QTableWidget {
    background-color: #FFFFFF;
    gridline-color: rgba(15, 32, 24, 0.08);
    border: 1px solid rgba(15, 32, 24, 0.12);
    border-radius: 14px;
    selection-background-color: rgba(27, 42, 102, 0.08);
    selection-color: #0F2018;
}
QHeaderView::section {
    background-color: #FFFFFF;
    color: #5C6F63;
    padding: 8px;
    border: none;
    border-bottom: 1px solid rgba(15, 32, 24, 0.12);
    font-weight: 600;
    font-size: 11.5px;
}

/* ---- Small helper label roles used across views ---- */
QLabel#eyebrow {
    color: #2CA85E;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 1px;
}
QLabel#heroTitle {
    font-family: "Segoe UI Semibold", "Segoe UI", sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #0F2018;
}
QLabel#heroSub {
    color: #5C6F63;
    font-size: 12.5px;
}
QLabel#pageTitle {
    font-family: "Segoe UI Semibold", "Segoe UI", sans-serif;
    font-size: 19px;
    font-weight: 600;
    color: #0F2018;
}
QLabel#modeBadgeLocal {
    background: #E4F2E7;
    color: #1B6B3A;
    border-radius: 8px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#modeBadgeRemote {
    background: #E9EDFB;
    color: #1B2A66;
    border-radius: 8px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#hintText {
    color: #5C6F63;
    font-size: 11.5px;
}
QLabel#panelHeading {
    font-family: "Segoe UI Semibold", "Segoe UI", sans-serif;
    font-weight: 600;
    font-size: 13.5px;
}
QLabel#logMeta {
    color: #5C6F63;
    font-family: Consolas, monospace;
    font-size: 11px;
}
QLabel#feedbackOk { color: #2CA85E; font-family: Consolas, monospace; font-size: 12px; }
QLabel#feedbackErr { color: #B23B2E; font-family: Consolas, monospace; font-size: 12px; }
QLabel#feedbackNeutral { color: #5C6F63; font-family: Consolas, monospace; font-size: 12px; }
QLabel#windowFooter {
    color: #5C6F63;
    font-family: Consolas, monospace;
    font-size: 10px;
}

QLabel#brandLabel {
    font-family: Consolas, monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: #5C6F63;
    font-weight: 600;
}

/* ---- Card container used for grouping content (e.g. panels) ---- */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 32, 24, 0.12);
    border-radius: 14px;
}

QFrame#titlebar {
    background-color: #FFFFFF;
    border-bottom: 1px solid rgba(15, 32, 24, 0.12);
}
